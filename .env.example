# Postgres (usado pelo docker-compose e pela aplicação)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Gemini — Google AI Studio (free tier). Gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.6-flash

# Modelos (plugáveis — trocar aqui alimenta os experimentos de avaliação)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
